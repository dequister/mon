# Copie para .env e preencha as chaves.

# Chaves de API dos provedores
GOOGLE_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Segurança (troque em produção)
JWT_SECRET=troque-este-segredo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Banco de dados
POSTGRES_USER=mon
POSTGRES_PASSWORD=mon
POSTGRES_DB=mon

# Modelos padrão (o administrador pode trocar o LLM pela interface)
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-3.8-flash
DEFAULT_RERANK_MODEL=rerank-v4.0-pro
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=3072

# OCR
OCR_LANGUAGES=por+eng
OCR_DPI=300

# Worker de jobs
WORKER_CONCURRENCY=2

# Porta pública da aplicação
APP_PORT=8080
